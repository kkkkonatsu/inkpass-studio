{
  "name": "inkpass-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fan-made Splatoon 3 student ID & staff ID generator (100% client-side, config-driven).",
  "scripts": {
    "dev": "node scripts/sync-card-fonts.mjs && vite",
    "build": "node scripts/sync-card-fonts.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-assets": "node scripts/sync-splatoon-assets.mjs",
    "sync-fonts": "node scripts/sync-card-fonts.mjs",
    "sync-presets": "node scripts/sync-splatoon-presets.mjs",
    "postinstall": "node scripts/sync-splatoon-assets.mjs && node scripts/sync-card-fonts.mjs"
  },
  "dependencies": {
    "jsbarcode": "^3.12.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.17.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^6.2.5",
    "splatoon-ui": "^0.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
